---
import Base from '../layouts/Base.astro';
import StyleCard from '../components/StyleCard.astro';
import { groups, styles, totalCount } from '../data/styles';
const base = import.meta.env.BASE_URL;

const featuredNumbers = ['001', '034', '041', '059', '092', '125', '217', '262'];
const featured = featuredNumbers
  .map((n) => styles.find((s) => s.number === n))
  .filter((s): s is (typeof styles)[number] => Boolean(s));

const steps = [
  { n: '01', title: '选一个编号', desc: '浏览全部 267 种风格，或按分组 A–H 快速定位，也可以直接搜索风格名或作者。' },
  { n: '02', title: '告诉主题', desc: '例如 "041 号风格，主题：秋天的第一杯奶茶"。不用会画画，也不用会描述画风。' },
  { n: '03', title: '拿到双语提示词', desc: '得到带风格名称的中文 + 英文提示词，复制进任何生图 AI 即可，画风稳定不漂移。' },
];
---

<Base>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow fade-in">手绘风格提示词库 · Handraw Style Prompter</p>
      <h1 class="fade-in">
        不会描述画风，<br />
        也能快速做出<br />
        <em>有辨识度</em>的图片
      </h1>
      <p class="lead fade-in">
        收录 <strong>{totalCount}</strong> 种手绘风格，一个编号对应一套中文 + 英文提示词。
        选风格、报主题、拿提示词——交给生图 AI 就好。
      </p>
      <div class="cta fade-in">
        <a class="btn btn--primary" href={`${base}styles`}>浏览全部风格</a>
        <a class="btn" href={`${base}gallery`}>查看拼图画廊</a>
      </div>
      <div class="stats fade-in">
        <div class="stat"><b>{totalCount}</b><span>种风格</span></div>
        <div class="stat"><b>{groups.length}</b><span>个分组 A–H</span></div>
        <div class="stat"><b>中英</b><span>双语提示词</span></div>
      </div>
    </div>
  </section>

  <section class="groups container section">
    <div class="section-head">
      <h2>按风格分组浏览</h2>
      <p>从社论漫画、绘本、平面插画，到日系、中国系与风格化 3D，先挑一个方向。</p>
    </div>
    <div class="group-grid">
      {
        groups.map((g) => (
          <a class="group-card" href={`${base}styles?group=${g.letter}`}>
            <span class="group-letter">{g.letter}</span>
            <div class="group-info">
              <b>{g.short}</b>
              <span>{g.range} · {g.count} 种</span>
            </div>
            <span class="group-arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="how container section">
    <div class="section-head">
      <h2>三步，生成一张有风格的图</h2>
    </div>
    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <span class="step-no">{s.n}</span>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="featured container section">
    <div class="section-head row">
      <div>
        <h2>精选风格</h2>
        <p>挑选几张跨分组的代表风格快速感受一下。</p>
      </div>
      <a class="btn btn--ghost" href={`${base}styles`}>全部风格 →</a>
    </div>
    <div class="featured-grid">
      {featured.map((s) => (
        <StyleCard
          number={s.number}
          name={s.generation_name}
          author={s.reference}
          group={s.group}
          groupLetter={s.group.trim().charAt(0).toUpperCase()}
          traits={s.traits}
        />
      ))}
    </div>
  </section>

  <section class="cta-band container">
    <h2>现在就从 001 开始？</h2>
    <p>浏览风格库，找到第一眼心动的那一个编号。</p>
    <a class="btn btn--accent" href={`${base}styles`}>去选风格</a>
  </section>
</Base>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
    background:
      radial-gradient(1200px 520px at 80% -10%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%),
      var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    max-width: 820px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 1.1rem;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent-ink);
    position: relative;
  }
  .hero h1 em::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.05em;
    height: 0.35em;
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    z-index: -1;
    border-radius: 2px;
  }
  .lead {
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: var(--ink-soft);
    max-width: 46rem;
  }
  .lead strong,
  .lead b {
    color: var(--ink);
  }
  .cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin: 1.4rem 0 2rem;
  }
  .stats {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .stat {
    display: flex;
    flex-direction: column;
  }
  .stat b {
    font-size: 1.9rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }
  .stat span {
    color: var(--ink-mute);
    font-size: 0.85rem;
    margin-top: 0.3rem;
  }

  .section {
    margin-top: 3.5rem;
  }
  .section-head {
    margin-bottom: 1.4rem;
  }
  .section-head h2 {
    font-size: 1.55rem;
  }
  .section-head p {
    color: var(--ink-mute);
    margin: 0;
  }
  .section-head.row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .group-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.9rem;
  }
  .group-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.14s, box-shadow 0.14s, border-color 0.14s;
  }
  .group-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--line-strong);
  }
  .group-letter {
    width: 46px;
    height: 46px;
    flex: none;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: var(--paper);
    border-radius: 12px;
    font-weight: 800;
    font-size: 1.2rem;
  }
  .group-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .group-info b {
    font-size: 1rem;
  }
  .group-info span {
    color: var(--ink-mute);
    font-size: 0.8rem;
    font-family: var(--mono);
  }
  .group-arrow {
    margin-left: auto;
    color: var(--accent-ink);
    font-size: 1.1rem;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    counter-reset: step;
  }
  .step {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem;
    position: relative;
  }
  .step-no {
    font-family: var(--mono);
    font-weight: 800;
    color: var(--accent-ink);
    font-size: 0.85rem;
  }
  .step h3 {
    margin: 0.4rem 0 0.3rem;
    font-size: 1.1rem;
  }
  .step p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin: 0;
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 1rem;
  }

  .cta-band {
    margin-top: 4rem;
    text-align: center;
    padding: 2.8rem 1.5rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 18px;
  }
  .cta-band h2 {
    font-size: 1.7rem;
  }
  .cta-band p {
    color: color-mix(in srgb, var(--paper) 70%, transparent);
  }
</style>