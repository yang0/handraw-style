---
import Base from '../../layouts/Base.astro';
import {
  styles,
  imagePath,
  sheetFor,
  neighbors,
  groupLetter,
  groupName,
} from '../../data/styles';

export function getStaticPaths() {
  return styles.map((s) => ({ params: { number: s.number }, props: { style: s } }));
}

interface Props {
  style: (typeof styles)[number];
}

const { style } = Astro.props;
const base = import.meta.env.BASE_URL;
const letter = groupLetter(style.group);
const group = groupName(style.group);
const sheet = sheetFor(style.number);
const { prev, next } = neighbors(style.number);
const img = imagePath(style.number);
const imgAbs = new URL(img, Astro.site).href;
const numHref = `#${style.number}`;
const enName = style.generation_name;
const zhPrompt = style.traits;
const styleTitle = `风格 ${style.number} · ${enName}`;
---

<Base
  title={`#${style.number} ${enName}`}
  description={`手绘风格 ${style.number}：${enName}（${style.reference}）。查看中文提示词并复制使用。`}
  canonicalPath={`/styles/${style.number}`}
  image={imgAbs}
  type="article"
>
  <article class="page container" data-number={style.number}>
    <nav class="crumbs" aria-label="面包屑">
      <a href={`${base}`}>首页</a> <span>/</span>
      <a href={`${base}styles`}>全部风格</a> <span>/</span>
      <span>#{style.number}</span>
    </nav>

    <div class="detail">
      <figure class="media">
        <img src={img} alt={`风格 ${style.number} · ${enName}`} width="1024" height="1024" fetchpriority="high" />
        {sheet && (
          <a class="sheet-link" href={`${base}gallery#sheet-${letter}-${sheet.start}-${sheet.end}`}>
            查看本组拼图 →
          </a>
        )}
      </figure>

      <div class="info">
        <div class="chips">
          <span class="chip">{style.number}</span>
          <a class="chip chip--accent" href={`${base}styles?group=${letter}`}>{letter} · {group}</a>
        </div>

        <h1 class="title">{enName}</h1>

        <p class="ref">
          <span class="k">原参考作者</span>
          <span class="v">{style.reference}</span>
        </p>

        <div class="tc-block">
          <div class="tc-head">
            <span>中文提示词</span>
            <button class="btn btn--ghost" type="button" data-copy={zhPrompt}>复制</button>
          </div>
          <p class="tc-body">{zhPrompt}</p>
          <div class="tc-head en">
            <span>English style name</span>
            <button class="btn btn--ghost" type="button" data-copy={enName}>Copy</button>
          </div>
          <p class="tc-body en">{enName}</p>
        </div>

        <div class="actions">
          <button class="btn" type="button" data-copy={numHref}>复制编号 {numHref}</button>
          <button class="btn" type="button" data-copy={enName}>复制风格名</button>
          <button class="btn" type="button" data-fav aria-pressed="false">☆ 收藏</button>
        </div>
        <p class="hint">编号用于在整个库里精确定位该风格；提示词复制后直接交给生图 AI。</p>
      </div>
    </div>

    <nav class="pager" aria-label="上一张 / 下一张">
      {prev && (
        <a class="pager-link" href={`${base}styles/${prev.number}`}>
          <span class="pl-arrow">←</span>
          <span class="pl-body">
            <span class="pl-k">上一个</span>
            <span class="pl-v">#{prev.number} {prev.generation_name}</span>
          </span>
        </a>
      )}
      {next && (
        <a class="pager-link next" href={`${base}styles/${next.number}`}>
          <span class="pl-body">
            <span class="pl-k">下一个</span>
            <span class="pl-v">#{next.number} {next.generation_name}</span>
          </span>
          <span class="pl-arrow">→</span>
        </a>
      )}
    </nav>
  </article>
</Base>

<style>
  .page {
    padding: 2rem 0 3rem;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--ink-mute);
    margin-bottom: 1.2rem;
  }
  .crumbs a:hover {
    color: var(--accent-ink);
  }

  .detail {
    display: grid;
    grid-template-columns: minmax(0, 520px) 1fr;
    gap: 2rem;
    align-items: start;
  }
  .media {
    margin: 0;
    position: sticky;
    top: 92px;
  }
  .media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  .sheet-link {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.9rem;
    color: var(--accent-ink);
  }
  .sheet-link:hover {
    text-decoration: underline;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .title {
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .ref {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 1.4rem;
    padding-bottom: 1.2rem;
    border-bottom: 1px solid var(--line);
  }
  .ref .k {
    color: var(--ink-mute);
    font-size: 0.85rem;
  }
  .ref .v {
    font-weight: 650;
  }

  .tc-block {
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
    margin-bottom: 1.4rem;
  }
  .tc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--ink-mute);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tc-head .btn {
    padding: 0.3rem 0.8rem;
    font-size: 0.8rem;
  }
  .tc-body {
    margin: 0.6rem 0 1.2rem;
    line-height: 1.75;
    color: var(--ink);
    font-size: 0.98rem;
  }
  .tc-head.en {
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }
  .tc-body.en {
    margin-top: 0.4rem;
    margin-bottom: 0;
    font-family: var(--mono);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .hint {
    margin: 0.9rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-mute);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.6rem;
    border-top: 1px solid var(--line);
    padding-top: 1.4rem;
  }
  .pager-link {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    flex: 1;
    padding: 0.9rem 1rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: transform 0.12s, box-shadow 0.12s, border-color 0.12s;
    max-width: 46%;
  }
  .pager-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--line-strong);
  }
  .pager-link.next {
    margin-left: auto;
    text-align: right;
  }
  .pl-arrow {
    font-size: 1.2rem;
    color: var(--accent-ink);
  }
  .pl-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .pl-k {
    font-size: 0.75rem;
    color: var(--ink-mute);
  }
  .pl-v {
    font-weight: 650;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 820px) {
    .detail {
      grid-template-columns: 1fr;
    }
    .media {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .pager {
      flex-direction: column;
    }
    .pager-link,
    .pager-link.next {
      max-width: 100%;
    }
  }
</style>